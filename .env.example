PROCURE_ENV=production
PROCURE_DOMAIN=procurement.example.com
PUBLIC_ORIGIN=https://procurement.example.com
ALLOWED_HOSTS=procurement.example.com,127.0.0.1,localhost,app
BOOTSTRAP_TOKEN=REPLACE_WITH_A_RANDOM_32_BYTE_SECRET
# HTTPS gateway adapters implementing docs/INTEGRATIONS.md
SAP_GATEWAY_URL=
SAP_GATEWAY_TOKEN=
EMAIL_GATEWAY_URL=
EMAIL_GATEWAY_TOKEN=
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_TOKEN=
# Shared Groq connection. Obtain keys privately; never commit this file after filling it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_INTAKE_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
AI_WORKER_ENABLED=true
# Optional token-price estimates, USD per million; leave blank when unknown.
GROQ_INPUT_USD_PER_MILLION=
GROQ_OUTPUT_USD_PER_MILLION=
# Automatic RFQs are opt-in and restricted to exact recipient addresses.
EMAIL_AUTOMATION_ENABLED=false
EMAIL_ALLOWED_RECIPIENTS=
EMAIL_REMINDER_DAYS=2
EMAIL_MAX_REMINDERS=2
# Optional adapters exposing GET /events?workflow=...
SUPPLIER_GATEWAY_URL=
SUPPLIER_GATEWAY_TOKEN=
WAREHOUSE_GATEWAY_URL=
WAREHOUSE_GATEWAY_TOKEN=
QUALITY_GATEWAY_URL=
QUALITY_GATEWAY_TOKEN=
# Signed event callbacks: X-Event-Timestamp and X-Event-Signature.
SUPPLIER_WEBHOOK_SECRET=
WAREHOUSE_WEBHOOK_SECRET=
QUALITY_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
